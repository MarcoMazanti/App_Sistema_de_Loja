<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Button?>

<?import javafx.scene.control.ListView?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="sistemaloja.aplicativo.Controller.HomeController"
            stylesheets="@../CSS/Home.css" styleClass="root">
    <left>
        <fx:include fx:id="barraLateral" source="BarraLateral.fxml" />
    </left>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content-scroll" >
            <VBox spacing="28" styleClass="content" >
                <HBox spacing="20" alignment="CENTER_LEFT">
                    <VBox spacing="4">
                        <Label text="Bem vindo, Nome Sobrenome" styleClass="page-title" fx:id="nomeHeaderLabel" />
                        <Label text="Aqui mostra o que está acontecendo com a loja." styleClass="page-subtitle"/>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="➕ Adicionar nova Venda" styleClass="btn-primary" fx:id="novaVendaButton" />
                </HBox>

                <GridPane hgap="16" vgap="16" styleClass="kpi-grid">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="33.34" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <VBox GridPane.columnIndex="0" styleClass="kpi-card">
                        <Label text="Total de Vendas" styleClass="kpi-label"/>
                        <Label text="R$ 0.00" styleClass="kpi-value" fx:id="totalVendasLabel" />
                    </VBox>

                    <VBox GridPane.columnIndex="1" styleClass="kpi-card">
                        <Label text="Quantidade de Empregados" styleClass="kpi-label"/>
                        <Label text="0" styleClass="kpi-value" fx:id="totalEmpregadoLabel" />
                    </VBox>

                    <VBox GridPane.columnIndex="2" styleClass="kpi-card">
                        <Label text="Total de Clientes" styleClass="kpi-label"/>
                        <Label text="0" styleClass="kpi-value" fx:id="totalClienteLabel" />
                    </VBox>
                </GridPane>

                <HBox spacing="20" VBox.vgrow="ALWAYS" >
                    <VBox HBox.hgrow="ALWAYS" styleClass="panel">
                        <Label text="Transações Recentes" styleClass="panel-title"/>
                        <ListView maxWidth="Infinity" fx:id="listaPagamentos" />
                    </VBox>

                    <VBox prefWidth="340" styleClass="panel">
                        <Label text="⚠ Baixo Estoque" styleClass="panel-title" style="-fx-padding: 0 0 10 0" />
                        <ScrollPane fitToWidth="true" style="-fx-background-color: #1e2837">
                            <Region VBox.vgrow="ALWAYS" />
                            <VBox spacing="10" fx:id="boxLowItem" >
                                <!-- Será adicionado pelo controller -->
                            </VBox>
                        </ScrollPane>
                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
