<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<BorderPane stylesheets="@../CSS/generic.css" styleClass="generic-pane"
            xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="sistemaloja.aplicativo.Controller.HeaderController"
            style="-fx-border-radius: 0 0 20 20; -fx-background-radius: 0 0 20 20;" prefHeight="70.0">

    <left>
        <VBox style="-fx-cursor: hand">
            <ImageView fitHeight="50" fitWidth="50" fx:id="exitIcon" onMouseClicked="#onExitIconClicked">
                <Image url="@../Images/exit.png" />
            </ImageView>
        </VBox>
    </left>
    <center>
        <Label style="-fx-font-size: 40px" text="Gerenciador de Loja" />
    </center>
    <right>
        <VBox style="-fx-cursor: hand">
            <ImageView fitHeight="50" fitWidth="50" fx:id="avatarIcon" onMouseClicked="#onAvatarIconClicked">
                <Image url="@../Images/avatar.png" />
            </ImageView>
        </VBox>
    </right>
</BorderPane>
