<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="sistemaloja.aplicativo.Controller.OptionsController"
            stylesheets="@../CSS/Options.css" styleClass="root">
    <left>
        <VBox prefWidth="260" styleClass="sidebar">
            <HBox spacing="12" styleClass="brand">
                <ImageView fitWidth="35" fitHeight="35">
                    <Image url="@../Images/avatar.png" />
                </ImageView>
                <VBox>
                    <Label text="Nome Sobrenome" styleClass="brand-title" fx:id="nomeSobrenomeLabel"/>
                    <Label text="Cargo" styleClass="brand-subtitle" fx:id="cargoLateralLabel" />
                </VBox>
            </HBox>

            <VBox spacing="6" style="-fx-spacing: 6;">
                <Button text="Home" styleClass="nav-item" onMouseClicked="#onHomeDisplayClicked" />
                <Button text="Filial" styleClass="nav-item" />
                <Button text="Empregado" styleClass="nav-item" />
                <Button text="Cliente" styleClass="nav-item" />
                <Button text="Fornecedor" styleClass="nav-item" />
                <Button text="Estoque" styleClass="nav-item" />
                <Button text="Pagamento" styleClass="nav-item" />
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <HBox style="-fx-cursor: hand" >
                <ImageView fitWidth="25" fitHeight="25" >
                    <Image url="@../Images/exit.png" />
                </ImageView>
                <Button text="Logout" styleClass="logout" onMouseClicked="#sairAplicativo"/>
            </HBox>
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" styleClass="content-scroll">
            <VBox spacing="25" styleClass="main-content" style="-fx-padding: 30 40;">

                <HBox alignment="BOTTOM_LEFT" spacing="20">
                    <VBox HBox.hgrow="ALWAYS" spacing="5">
                        <Label text="Gerenciamento de Estoque" styleClass="page-title"/>
                    </VBox>
                    <HBox spacing="10">
                        <Button text="Adicionar Novo Item" styleClass="btn-primary"/>
                    </HBox>
                </HBox>

                <GridPane hgap="15" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="33.33"/>
                        <ColumnConstraints percentWidth="33.34"/>
                        <ColumnConstraints percentWidth="33.33"/>
                    </columnConstraints>

                    <VBox styleClass="stat-card" GridPane.columnIndex="0">
                        <Label text="Total de Itens" styleClass="stat-label"/>
                        <Label text="1,240" styleClass="stat-value"/>
                    </VBox>
                    <VBox styleClass="stat-card" GridPane.columnIndex="1">
                        <Label text="Itens Baixos em Estoque" styleClass="stat-label"/>
                        <Label text="12" styleClass="stat-value"/>
                    </VBox>
                    <VBox styleClass="stat-card" GridPane.columnIndex="2">
                        <Label text="Itens sem Estoque" styleClass="stat-label"/>
                        <Label text="4" styleClass="stat-value"/>
                    </VBox>
                </GridPane>

                <HBox spacing="15" styleClass="toolbar-card">
                    <TextField promptText="Pesquise pelo Nome ou pelo Código..." HBox.hgrow="ALWAYS" styleClass="search-field"/>
                    <ComboBox promptText="Filiais" prefWidth="150"/>
                    <ComboBox promptText="Fornecedores" prefWidth="150"/>
                    <ComboBox promptText="Status de Estoque" prefWidth="150"/>
                </HBox>

                <VBox VBox.vgrow="ALWAYS" styleClass="table-container">
                    <TableView fx:id="inventoryTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn text="Code" prefWidth="120"/>
                            <TableColumn text="Name" prefWidth="200"/>
                            <TableColumn text="Branch" prefWidth="80"/>
                            <TableColumn text="Supplier" prefWidth="100"/>
                            <TableColumn text="Description" prefWidth="300"/>
                            <TableColumn text="Price" prefWidth="100"/>
                            <TableColumn text="Quantity" prefWidth="100"/>
                            <TableColumn text="Actions" prefWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
